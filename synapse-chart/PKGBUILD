# Maintainer: Mario Giustiniani <mariogiustiniani@gmail.com>
pkgname=synapse-chart
pkgver=0.1.0.alpha1
pkgrel=4
pkgdesc='Bounded C4 and Knowledge graph compiler with native terminal viewer'
arch=('x86_64')
url='https://github.com/synapse-linux/synapse-chart'
license=('MIT')
depends=('glibc' 'libsynapse-core' 'json-c' 'libarchive' 'openssl' 'ncurses' 'xdg-utils')
makedepends=('gcc' 'make' 'pkgconf')
checkdepends=('python' 'nodejs' 'desktop-file-utils' 'libxml2' 'util-linux')
optdepends=('foot: desktop native TUI launch'
            'firefox: optional graphical interactive HTML viewing')
options=('!lto' '!debug')
_repo=synapse-chart
_commit=2389a71a5530df966d9cdd871658d878a148fe21
_source_date_epoch=1788035241
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/synapse-linux/$_repo/tar.gz/$_commit")
sha256sums=('13524eeedd25445aa38ad705adaee8097ee8d92a81b1327c4831130d58120299')

_baseline_cflags='-O2 -g -std=c17 -Wall -Wextra -Wpedantic -Werror -fstack-protector-strong -fPIE -march=x86-64 -mtune=generic'
_baseline_ldflags='-Wl,-z,relro,-z,now -pie'

_core_args() {
  CORE_ARGS=()
  [[ -z ${SYNAPSE_CORE_ROOT:-} ]] || CORE_ARGS+=(CORE_ROOT="$SYNAPSE_CORE_ROOT")
}

build() {
  cd "$_repo-$_commit"
  _core_args
  make clean "${CORE_ARGS[@]}"
  SOURCE_DATE_EPOCH="$_source_date_epoch" make all "${CORE_ARGS[@]}" \
    CPPFLAGS='-D_FORTIFY_SOURCE=3' \
    CFLAGS="$_baseline_cflags" \
    LDFLAGS="$_baseline_ldflags"
}

check() {
  cd "$_repo-$_commit"
  _core_args
  SOURCE_DATE_EPOCH="$_source_date_epoch" make test "${CORE_ARGS[@]}"
}

package() {
  cd "$_repo-$_commit"
  _core_args
  make DESTDIR="$pkgdir" PREFIX=/usr install "${CORE_ARGS[@]}"
}
