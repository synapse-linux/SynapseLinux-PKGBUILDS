# Maintainer: Mario Giustiniani <mariogiustiniani@gmail.com>
pkgname=synapse-video
pkgver=0.1.0.dev7
pkgrel=1
pkgdesc='Provider-neutral CLI and contracts for canonical video projects and deterministic Silence Cut workflows'
arch=('x86_64')
url='https://github.com/synapse-linux/synapse-video'
license=('MIT')
depends=('python' 'ffmpeg')
makedepends=('python' 'python-setuptools')
checkdepends=('python')
options=('!lto' '!debug')
_repo=synapse-video
_commit=6e8d83a5d00a774f4a4cc4db1e54923b2829e36d
_source_date_epoch=1788035241
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/synapse-linux/$_repo/tar.gz/$_commit")
sha256sums=('0c6f42489508e1660af2f7e7fad6ba3d0bddc7ff8108d61784336faa0b80c76d')

build() {
  cd "$_repo-$_commit"
  SOURCE_DATE_EPOCH="$_source_date_epoch" make check
}

check() {
  cd "$_repo-$_commit"
  SOURCE_DATE_EPOCH="$_source_date_epoch" make test
}

package() {
  cd "$_repo-$_commit"
  local site_packages="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"
  install -D -m 0644 src/synapse_video/*.py -t "$pkgdir$site_packages/synapse_video/"
  install -D -m 0755 bin/synapse-audio-analyze -t "$pkgdir/usr/bin/"
  install -D -m 0755 bin/synapse-media-inspect -t "$pkgdir/usr/bin/"
  install -D -m 0755 bin/synapse-preview -t "$pkgdir/usr/bin/"
  install -D -m 0755 bin/synapse-render -t "$pkgdir/usr/bin/"
  install -D -m 0755 bin/synapse-timeline -t "$pkgdir/usr/bin/"
  install -D -m 0755 bin/synapse-video -t "$pkgdir/usr/bin/"
  install -D -m 0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -D -m 0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -D -m 0644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
